{
  "name": "billshield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "fixtures": "tsx scripts/fixtures.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "pitch": "tsx scripts/pitch.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pdf-parse": "2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.10.1",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
